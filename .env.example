# Copy to .env (never commit it) or export these in your shell.

# --- Database ---
# Local: use the MYSQL_* values below. On Render (or any hosted MySQL) set ONE
# DATABASE_URL instead and the MYSQL_* values are ignored, e.g.
#   DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/defaultdb
# Add ?ssl_ca=/etc/ssl/certs/ca-certificates.crt if your provider requires SSL.
# DATABASE_URL=

# --- MySQL (local development) ---
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=change-me

# --- Flask (use two DIFFERENT long random strings) ---
# python -c "import secrets; print(secrets.token_hex(32))"
TEACHER_SECRET_KEY=change-me
MANAGEMENT_SECRET_KEY=change-me-too
STUDENT_SECRET_KEY=change-me-three
TEACHER_PORT=8000
MANAGEMENT_PORT=5000
STUDENT_PORT=9000
FLASK_DEBUG=0

# --- Gemini (teacher side AI assistant) ---
GEMINI_API_KEY=change-me

# --- Gmail sender accounts (use Google "App passwords") ---
ADMIN1_EMAIL=admin1@gmail.com
ADMIN1_APP_PASSWORD=xxxx xxxx xxxx xxxx
ADMIN2_EMAIL=admin2@gmail.com
ADMIN2_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- College structure and academic rules (all optional) ---
DEPARTMENTS=CSE,IT,AIDS,ECE,EEE,MECH,CIVIL
SECTIONS=A,B,C,D
MAX_YEAR=4
PASS_MARK=50
MIN_ATTENDANCE=75

# --- Multi-college (optional) ---
# Every college gets its own database (smc_<college name>). This small database
# only lists the colleges. The MySQL user must be allowed to CREATE DATABASE.
MASTER_DATABASE=smartmentor_master

# --- Deployment (Render) ---
# TRUST_PROXY=1               # behind Render's HTTPS proxy
# SESSION_COOKIE_SECURE=1     # cookies only over HTTPS
# FACE_ID_DIR=/var/data/face_ids   # point at a persistent disk to keep Face ID photos
